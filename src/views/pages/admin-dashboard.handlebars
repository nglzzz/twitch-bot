<section class="admin-page admin-dashboard">
  <div class="admin-page__heading">
    <div><div class="eyebrow">Управление каналом</div><h1>Обзор</h1></div>
    {{#if stream}}
      {{#if stream.isLive}}<span class="admin-live admin-live--on">● В эфире · {{stream.durationLabel}}</span>{{else}}<span class="admin-live">Офлайн</span>{{/if}}
    {{/if}}
  </div>
  {{#if success}}<p class="form-notice form-notice--success" role="status">{{success}}</p>{{/if}}
  {{#if error}}<p class="form-notice form-notice--error" role="alert">{{error}}</p>{{/if}}

  {{#if attention.total}}
    <a class="admin-attention" href="/admin/community-events">
      <span class="admin-attention__count">{{attention.totalLabel}}</span>
      <span class="admin-attention__text"><strong>Событий ждут привязки к участникам</strong><small>Мемов: {{attention.memes}} · Донатов: {{attention.donations}}. После привязки обновятся профили и достижения.</small></span>
      <span class="admin-attention__arrow" aria-hidden="true">→</span>
    </a>
  {{/if}}

  <div class="admin-metrics">
    <article>
      <span>Донаты за 30 дней</span>
      <strong>{{metrics.donationsMonth.primary}}</strong>
      <small{{#if metrics.rateNote}} title="{{metrics.rateNote}}"{{/if}}>{{metrics.donationsMonth.count}} шт.{{#if metrics.donationsMonth.extra}} · {{metrics.donationsMonth.extra}}{{/if}}</small>
    </article>
    <article>
      <span>Сообщений за 7 дней</span>
      <strong>{{metrics.chatMessages}}</strong>
      {{#if metrics.chatMessagesTrend}}<small class="admin-trend admin-trend--{{metrics.chatMessagesTrend.direction}}">{{metrics.chatMessagesTrend.label}}</small>{{else}}<small>нет данных для сравнения</small>{{/if}}
    </article>
    <article>
      <span>Чаттеров за 7 дней</span>
      <strong>{{metrics.chatters}}</strong>
      {{#if metrics.chattersTrend}}<small class="admin-trend admin-trend--{{metrics.chattersTrend.direction}}">{{metrics.chattersTrend.label}}</small>{{else}}<small>нет данных для сравнения</small>{{/if}}
    </article>
    <article>
      <span>Участников сообщества</span>
      <strong>{{metrics.communityTotal}}</strong>
      <small>+{{metrics.communityNew}} за неделю</small>
    </article>
  </div>

  <div class="admin-dashboard__row">
    <article class="admin-card admin-chart-card">
      <div class="admin-card__head">
        <h2>Сообщения в чате</h2>
        <span class="admin-card__meta">14 дней · всего {{chatChart.total}}</span>
      </div>
      <ol class="admin-bars" aria-label="Сообщений в чате по дням за 14 дней, максимум {{chatChart.max}}">
        {{#each chatChart.bars}}
          <li class="admin-bars__item{{#if isToday}} is-today{{/if}}" aria-label="{{label}}: {{countLabel}}">
            <span class="admin-bars__track"><span class="admin-bars__bar{{#if isEmpty}} is-empty{{/if}}" style="height: {{height}}%"></span></span>
            <span class="admin-bars__tip" aria-hidden="true">{{weekday}}, {{label}}<b>{{countLabel}}</b></span>
            <span class="admin-bars__label" aria-hidden="true">{{shortLabel}}</span>
          </li>
        {{/each}}
      </ol>
    </article>

    <article class="admin-card admin-stream-card">
      <div class="admin-card__head">
        <h2>{{#if stream.isLive}}Текущий стрим{{else}}Последний стрим{{/if}}</h2>
      </div>
      {{#if stream}}
        <p class="admin-stream-card__title">{{stream.title}}</p>
        <p class="admin-card__meta">{{#if stream.game}}{{stream.game}} · {{/if}}{{stream.startedAtLabel}} · {{stream.durationLabel}}</p>
        <dl class="admin-facts">
          <div><dt>Пик зрителей</dt><dd>{{stream.maxViewers}}</dd></div>
          <div><dt>В среднем</dt><dd>{{stream.avgViewers}}</dd></div>
          <div><dt>Сообщений</dt><dd>{{stream.messages}}</dd></div>
          <div><dt>Чаттеров</dt><dd>{{stream.chatters}}</dd></div>
        </dl>
      {{else}}
        <p class="empty-state">Стримов пока нет.</p>
      {{/if}}
      <h3 class="admin-card__subhead">За 30 дней</h3>
      <dl class="admin-facts">
        <div><dt>Стримов</dt><dd>{{streamsMonth.count}}</dd></div>
        <div><dt>В эфире</dt><dd>{{streamsMonth.duration}}</dd></div>
        <div><dt>Пик зрителей</dt><dd>{{streamsMonth.peakViewers}}</dd></div>
        <div><dt>Средний онлайн</dt><dd>{{streamsMonth.avgViewers}}</dd></div>
      </dl>
    </article>
  </div>

  <div class="admin-dashboard__columns">
    <article class="admin-card">
      <div class="admin-card__head"><h2>Последние донаты</h2><a class="admin-card__link" href="/admin/donations/history">Все →</a></div>
      {{#if recentDonations.length}}
        <div class="admin-list">
          {{#each recentDonations}}
            <div class="admin-list__row">
              <div><strong>{{donorName}}</strong>{{#if message}}<span class="admin-list__clamp">{{message}}</span>{{/if}}</div>
              <div><strong>{{amountLabel}}</strong><span>{{createdAtLabel}}</span></div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="empty-state">Донатов пока нет.</p>
      {{/if}}
    </article>

    <article class="admin-card">
      <div class="admin-card__head"><h2>Топ донатеров</h2><span class="admin-card__meta">30 дней</span></div>
      {{#if topDonors.length}}
        <ol class="admin-rank">
          {{#each topDonors}}<li><span class="admin-rank__name">{{donorName}}</span><span class="admin-rank__value">{{amountLabel}}<small>{{count}} шт.</small></span></li>{{/each}}
        </ol>
      {{else}}
        <p class="empty-state">За месяц донатов не было.</p>
      {{/if}}
    </article>

    <article class="admin-card">
      <div class="admin-card__head"><h2>Активные в чате</h2><span class="admin-card__meta">7 дней</span></div>
      {{#if topChatters.length}}
        <ol class="admin-rank">
          {{#each topChatters}}<li><a class="admin-rank__name" href="/users/{{login}}">{{displayName}}</a><span class="admin-rank__value">{{messagesLabel}}<small>сообщ.</small></span></li>{{/each}}
        </ol>
      {{else}}
        <p class="empty-state">За неделю в чате было тихо.</p>
      {{/if}}
    </article>
  </div>
</section>
