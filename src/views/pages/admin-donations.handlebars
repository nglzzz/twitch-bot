<section class="admin-page">
  <div class="admin-page__heading"><div><div class="eyebrow">Служебное</div><h1>Служебный раздел</h1></div></div>
  <details class="admin-private" {{#if revealed}}open{{/if}}>
    <summary class="admin-private__curtain">
      <span class="admin-private__text"><strong class="admin-private__show">Содержимое скрыто</strong><strong class="admin-private__hide">Раздел открыт</strong><small>Раздел открывается только по клику, чтобы случайно не попасть в кадр. Esc — скрыть снова.</small></span>
      <span class="btn btn--ghost admin-private__toggle"><span class="admin-private__show">Показать</span><span class="admin-private__hide">Скрыть</span></span>
    </summary>
    <div class="admin-private__body">
      <nav class="admin-tabs" aria-label="Служебные разделы">
        <a class="admin-tabs__link is-active" href="/admin/donations?open=1" aria-current="page">Донаты</a>
        <a class="admin-tabs__link" href="/admin/memes?open=1">Мемы</a>
      </nav>
      {{#if success}}<p class="form-notice form-notice--success" role="status">{{success}}</p>{{/if}}
      {{#if error}}<p class="form-notice form-notice--error" role="alert">{{error}}</p>{{/if}}
      <div class="admin-grid">
        <article class="admin-card">
          <h2>Новый донат</h2>
          <p class="admin-card__hint">Уходит в StreamElements так же, как импорт из DonationAlerts, и помечается тестовым: в статистику и профили участников не попадает.</p>
          <form method="post" action="/admin/donations" class="admin-form">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <label>Ник<input name="donorName" maxlength="100" required /></label>
            <div class="admin-form__columns admin-form__columns--amount">
              <label>Сумма<input name="amount" type="number" step="0.01" min="0.01" required /></label>
              <label>Валюта<input name="currency" value="RUB" maxlength="8" /></label>
            </div>
            <label>Сообщение<textarea name="message" maxlength="255"></textarea></label>
            <label>Дата и время <small>только для расписания</small><input name="scheduledFor" type="datetime-local" value="{{defaultScheduledFor}}" /></label>
            <div class="admin-form__actions">
              <button class="btn btn--primary" type="submit" name="mode" value="schedule">Запланировать</button>
              <button class="btn btn--ghost" type="submit" name="mode" value="now">Отправить сейчас</button>
            </div>
          </form>
        </article>
        <article class="admin-card">
          <h2>Очередь</h2>
          {{#if hasScheduledDonations}}
            <div class="admin-list">
              {{#each scheduledDonations}}
                <div class="admin-list__row">
                  <div>
                    <strong>{{donorName}} · {{amountLabel}}</strong>
                    {{#if message}}<span>{{message}}</span>{{/if}}
                    {{#if errorLabel}}<span class="admin-list__error">Ошибка: {{errorLabel}}</span>{{/if}}
                  </div>
                  <div>
                    <strong>{{scheduledForLabel}}</strong>
                    <span class="admin-status admin-status--{{status}}">{{statusLabel}}</span>
                    <div class="admin-list__actions">
                      {{#if (or (eq status 'pending') (eq status 'failed'))}}<form method="post" action="/admin/donations/{{_id}}/send-now"><input type="hidden" name="_csrf" value="{{../csrfToken}}" /><button class="admin-link-button" type="submit">Отправить сейчас</button></form>{{/if}}
                      {{#if (eq status 'pending')}}<form method="post" action="/admin/donations/{{_id}}/cancel"><input type="hidden" name="_csrf" value="{{../csrfToken}}" /><button class="admin-link-button" type="submit">Отменить</button></form>{{/if}}
                      <form method="post" action="/admin/donations/{{_id}}/delete"><input type="hidden" name="_csrf" value="{{../csrfToken}}" /><button class="admin-link-button admin-link-button--danger" type="submit">Удалить</button></form>
                    </div>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="empty-state">Очередь пуста.</p>
          {{/if}}
        </article>
      </div>
    </div>
  </details>
</section>
