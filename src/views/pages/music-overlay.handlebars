<style>
  html, body { background: transparent !important; margin: 0; overflow: hidden; }
  body { font-family: 'Inter', system-ui, sans-serif; color: #fff; -webkit-font-smoothing: antialiased; }
  .mo { position: fixed; inset: 0; --accent: #1ed760; --u: 1vh; }
  .mo[hidden] { display: block !important; }
  .mo__stage { position: absolute; inset: 0; opacity: 0; transform: translateY(6%); transition: opacity .6s ease, transform .6s cubic-bezier(.2,.8,.2,1); }
  .mo.is-visible .mo__stage { opacity: 1; transform: none; }

  /* ---------- карточка (режим «плеер»), 1u = 1% высоты источника ---------- */
  .mo-card { position: absolute; inset: calc(var(--u) * 3); display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: calc(var(--u) * 7); padding: calc(var(--u) * 8); border-radius: calc(var(--u) * 9); overflow: hidden; isolation: isolate; background: rgba(10, 10, 16, .34); box-shadow: 0 calc(var(--u) * 3) calc(var(--u) * 12) rgba(0, 0, 0, .45), inset 0 0 0 1px rgba(255, 255, 255, .06); }
  .mo-card__bg { position: absolute; inset: -20%; z-index: -1; background: var(--art) center / cover no-repeat; filter: blur(calc(var(--u) * 10)) saturate(1.2) brightness(.7); transform: scale(1.1); opacity: .55; transition: background-image .8s ease; }
  .mo-card__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(8, 10, 18, .6) 20%, rgba(8, 10, 18, .4)); }
  /* Фон полупрозрачный — тень держит читаемость текста поверх игры. */
  .mo-card .mo-meta { text-shadow: 0 1px 3px rgba(0, 0, 0, .55), 0 0 calc(var(--u) * 4) rgba(0, 0, 0, .35); }
  .mo-card .mo-chip { text-shadow: none; }
  .mo-art { position: relative; height: 72vh; aspect-ratio: 1; border-radius: calc(var(--u) * 5); background: #222 var(--art-square) center / cover no-repeat; box-shadow: 0 calc(var(--u) * 2) calc(var(--u) * 8) rgba(0, 0, 0, .55); transition: background-image .4s ease; }
  .mo-meta { display: grid; gap: calc(var(--u) * 2.6); min-width: 0; }
  .mo-label { display: flex; align-items: center; gap: .5em; font-size: calc(var(--u) * 6.2); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255, 255, 255, .66); }
  .mo-title { font-size: calc(var(--u) * 13.8); line-height: 1.15; font-weight: 800; letter-spacing: -.015em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 1px 12px rgba(0, 0, 0, .35); }
  .mo-title span { display: inline-block; }
  .mo-title.is-long { text-overflow: clip; mask-image: linear-gradient(90deg, #000 calc(100% - 1.2em), transparent); }
  .mo-title.is-long span { animation: mo-marquee var(--marquee, 12s) ease-in-out infinite alternate; }
  .mo-sub { display: flex; align-items: center; gap: .5em; min-width: 0; font-size: calc(var(--u) * 8.5); font-weight: 500; color: rgba(255, 255, 255, .78); white-space: nowrap; }
  .mo-sub__author { overflow: hidden; text-overflow: ellipsis; }
  .mo-chip { flex: none; display: inline-flex; align-items: center; gap: .3em; padding: .12em .6em; border-radius: 999px; font-size: .78em; font-weight: 700; color: #fff; background: rgba(255, 255, 255, .16); }
  .mo-chip--paid { color: #1a1300; background: linear-gradient(90deg, #ffd54a, #ffb300); }
  .mo-chip[hidden] { display: none !important; }
  .mo-progress { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: calc(var(--u) * 4); margin-top: calc(var(--u) * 1.5); font-size: calc(var(--u) * 6.2); font-weight: 600; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, .7); }
  .mo-bar { position: relative; height: calc(var(--u) * 2.2); min-height: 3px; border-radius: 999px; background: rgba(255, 255, 255, .18); overflow: hidden; }
  .mo-bar__fill { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: inherit; background: rgba(255, 255, 255, .85); }
  .mo.is-playing .mo-bar__fill { background: var(--accent); box-shadow: 0 0 calc(var(--u) * 3) rgba(30, 215, 96, .45); }
  .mo-eq { display: inline-flex; align-items: flex-end; gap: .12em; height: .9em; }
  .mo-eq i { width: .16em; min-width: 2px; height: 30%; border-radius: 1px; background: var(--accent); }
  .mo.is-playing .mo-eq i { animation: mo-eq 1s ease-in-out infinite; }
  .mo-eq i:nth-child(2) { animation-delay: -.35s !important; }
  .mo-eq i:nth-child(3) { animation-delay: -.7s !important; }
  .mo-paused { display: none; width: .9em; height: .9em; fill: currentColor; }
  .mo.is-paused .mo-paused { display: inline-block; }
  .mo.is-paused .mo-eq { display: none; }

  /* Высокий/квадратный источник: обложка сверху, текст снизу. 1u = 1% ширины / 2. */
  @media (max-aspect-ratio: 3/2) {
    .mo { --u: .5vw; }
    .mo-card { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; align-content: center; justify-items: start; gap: calc(var(--u) * 6.4); padding: calc(var(--u) * 9.6); }
    /* Обложка занимает всё, что осталось после текста (~46vw), но не больше 64vw. */
    .mo-art { height: auto; width: min(64vw, calc(100vh - 46vw)); max-width: 100%; justify-self: center; }
    .mo-meta { width: 100%; gap: calc(var(--u) * 2.4); }
    .mo-label { font-size: calc(var(--u) * 5.2); }
    .mo-title { font-size: calc(var(--u) * 12); white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; text-overflow: ellipsis; }
    .mo-title span { display: inline; }
    .mo-sub { font-size: calc(var(--u) * 7.2); }
    .mo-progress { margin-top: calc(var(--u) * 4); font-size: calc(var(--u) * 6.4); }
    .mo-bar { height: calc(var(--u) * 2); }
  }

  /* ---------- режим «видео»: нижняя плашка, 1u = 1% высоты ---------- */
  .mo-video { position: absolute; inset: 0; background: #000; overflow: hidden; }
  /* iframe выше кадра: плашки YouTube (название, логотип) уходят за край и обрезаются. */
  .mo-video__frame, .mo-video iframe { position: absolute; top: 50%; left: 50%; width: max(100vw, 177.78vh); height: calc(max(100vh, 56.25vw) + 240px); transform: translate(-50%, -50%); border: 0; pointer-events: none; }
  .mo-video__bar { position: absolute; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: calc(var(--u) * 2.2); align-items: center; padding: calc(var(--u) * 10) calc(var(--u) * 3.3) calc(var(--u) * 3.3); background: linear-gradient(0deg, rgba(0, 0, 0, .88), rgba(0, 0, 0, .6) 55%, transparent); }
  /* Видео не запустилось (ошибка или проверка YouTube) — вместо iframe размытая обложка. */
  .mo-video__fallback { position: absolute; inset: -10%; background: var(--art) center / cover no-repeat; filter: blur(calc(var(--u) * 6)) brightness(.5) saturate(1.3); opacity: 0; transition: opacity .6s ease; }
  .mo-video.is-fallback .mo-video__fallback { opacity: 1; }
  /* Крупная обложка по центру свободной области над нижней плашкой. */
  .mo-video__cover { position: absolute; left: 50%; top: 42%; height: 56vh; aspect-ratio: 16 / 9; max-width: 86vw; border-radius: calc(var(--u) * 2.4); background: var(--art-hd, none) center / cover no-repeat, var(--art) center / cover no-repeat, #111; box-shadow: 0 calc(var(--u) * 3) calc(var(--u) * 10) rgba(0, 0, 0, .6), inset 0 0 0 1px rgba(255, 255, 255, .08); transform: translate(-50%, -50%) scale(.96); opacity: 0; transition: opacity .6s ease, transform .6s ease; }
  .mo-video.is-fallback .mo-video__cover { opacity: 1; transform: translate(-50%, -50%); }
  .mo-video.is-fallback .mo-video__frame, .mo-video.is-fallback iframe { visibility: hidden; }
  .mo--video .mo-art { height: calc(var(--u) * 12.8); border-radius: calc(var(--u) * 1.2); }
  .mo--video .mo-meta { gap: calc(var(--u) * .7); }
  .mo--video .mo-label { gap: calc(var(--u) * .8); font-size: calc(var(--u) * 1.95); }
  .mo--video .mo-title { font-size: calc(var(--u) * 3.9); }
  .mo--video .mo-sub { font-size: calc(var(--u) * 2.5); }
  .mo--video .mo-progress { font-size: calc(var(--u) * 1.95); gap: calc(var(--u) * 1.6); margin-top: calc(var(--u) * .4); }
  .mo--video .mo-bar { height: calc(var(--u) * .7); }

  @keyframes mo-eq { 0%, 100% { height: 25%; } 50% { height: 100%; } }
  @keyframes mo-marquee { 0%, 18% { transform: translateX(0); } 82%, 100% { transform: translateX(calc(-1 * var(--shift, 0px))); } }
  @media (prefers-reduced-motion: reduce) { .mo * { animation: none !important; transition: none !important; } }
</style>

<div class="mo mo--{{mode}}" data-mode="{{mode}}" id="music-overlay">
  <div class="mo__stage">
    {{#if (eq mode "video")}}
      <div class="mo-video">
        <div class="mo-video__fallback" aria-hidden="true"></div>
        <div class="mo-video__cover" aria-hidden="true"></div>
        <div class="mo-video__frame" id="mo-yt"></div>
        <div class="mo-video__bar">
          <div class="mo-art" data-art></div>
          <div class="mo-meta">
            <div class="mo-label"><span class="mo-eq" aria-hidden="true"><i></i><i></i><i></i></span><svg class="mo-paused" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg><span data-label>Сейчас играет</span></div>
            <div class="mo-title" data-title><span></span></div>
            <div class="mo-sub"><span class="mo-sub__author" data-author></span><span class="mo-chip" data-chip></span></div>
            <div class="mo-progress"><span data-pos>0:00</span><span class="mo-bar"><span class="mo-bar__fill" data-fill></span></span><span data-len>0:00</span></div>
          </div>
        </div>
      </div>
    {{else}}
      <div class="mo-card">
        <div class="mo-card__bg" aria-hidden="true"></div>
        <div class="mo-art" data-art></div>
        <div class="mo-meta">
          <div class="mo-label"><span class="mo-eq" aria-hidden="true"><i></i><i></i><i></i></span><svg class="mo-paused" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg><span data-label>Сейчас играет</span></div>
          <div class="mo-title" data-title><span></span></div>
          <div class="mo-sub"><span class="mo-sub__author" data-author></span><span class="mo-chip" data-chip></span></div>
          <div class="mo-progress"><span data-pos>0:00</span><span class="mo-bar"><span class="mo-bar__fill" data-fill></span></span><span data-len>0:00</span></div>
        </div>
      </div>
    {{/if}}
  </div>
</div>

<script src="/js/music-client.js"></script>
<script>
(function () {
  'use strict';
  var root = document.getElementById('music-overlay');
  var mode = root.getAttribute('data-mode');
  var params = new URLSearchParams(location.search);
  var showIdle = params.get('idle') === '1';
  var el = function (name) { return root.querySelector('[data-' + name + ']'); };
  var titleBox = el('title');
  var lastId = null;
  var ytPlayer = null;
  var ytReady = false;
  var ytLoadedId = null;
  var videoStartedId = null; // трек, для которого видео реально пошло
  var videoWatchdog = null;
  var VIDEO_START_TIMEOUT_MS = 10000;

  function setVideoFallback(on) {
    var box = root.querySelector('.mo-video');
    if (box) box.classList.toggle('is-fallback', on);
  }

  // Если видео не стартовало (проверка «вы не бот», запрет встраивания) — показываем обложку.
  function armVideoWatchdog(trackId) {
    clearTimeout(videoWatchdog);
    videoWatchdog = setTimeout(function () {
      videoWatchdog = null;
      var state = client.getState();
      if (ytLoadedId === trackId && videoStartedId !== trackId && isAudible(state)) setVideoFallback(true);
    }, VIDEO_START_TIMEOUT_MS);
  }

  function setText(node, text) { if (node && node.textContent !== text) node.textContent = text; }

  function art(track, square) {
    if (!track) return 'none';
    if (track.provider === 'youtube') return 'url("https://i.ytimg.com/vi/' + track.externalId + (square ? '/mqdefault.jpg")' : '/hqdefault.jpg")');
    return track.thumbnail ? 'url("' + String(track.thumbnail).replace(/"/g, '%22') + '")' : 'none';
  }

  // Обложка 640×480 для запасного вида видео. Если её нет, YouTube отдаёт
  // заглушку 120×90 — тогда остаётся hqdefault из --art.
  function loadHdArt(track) {
    root.style.setProperty('--art-hd', 'none');
    if (mode !== 'video' || track.provider !== 'youtube') return;
    var url = 'https://i.ytimg.com/vi/' + track.externalId + '/sddefault.jpg';
    var probe = new Image();
    probe.onload = function () {
      if (lastId === track.id && probe.naturalWidth > 120) root.style.setProperty('--art-hd', 'url("' + url + '")');
    };
    probe.src = url;
  }

  function updateMarquee() {
    var inner = titleBox.firstElementChild;
    titleBox.classList.remove('is-long');
    // В вертикальном формате название переносится на две строки, бегущая строка не нужна.
    if (window.matchMedia('(max-aspect-ratio: 3/2)').matches && mode !== 'video') return;
    // scrollWidth блока учитывает переполнение строки.
    var overflow = titleBox.scrollWidth - titleBox.clientWidth;
    if (overflow > 4) {
      var fade = parseFloat(getComputedStyle(titleBox).fontSize) * 1.2;
      var shift = overflow + fade;
      titleBox.classList.add('is-long');
      titleBox.style.setProperty('--shift', shift + 'px');
      // ~30 px/с на прокрутку + паузы на концах (36% цикла).
      titleBox.style.setProperty('--marquee', Math.max(6, shift / 30 / 0.64) + 's');
    }
  }

  // Трек реально звучит, только когда сервер в статусе playing и плеер-док на связи.
  function isAudible(state) {
    return Boolean(state && state.current && state.status === 'playing' && state.player && state.player.online);
  }

  function render(state) {
    var track = state && state.current;
    var visible = Boolean(track) || showIdle;
    root.classList.toggle('is-visible', visible);
    root.classList.toggle('is-playing', isAudible(state));
    root.classList.toggle('is-paused', Boolean(track) && !isAudible(state));
    if (!track) {
      if (showIdle) {
        setText(titleBox.firstElementChild, 'Закажи трек: !sr <ссылка или название>');
        setText(el('author'), 'Очередь пуста');
        el('chip').hidden = true;
      }
      syncVideo(state);
      return;
    }
    if (track.id !== lastId) {
      lastId = track.id;
      root.style.setProperty('--art', art(track, false));
      root.style.setProperty('--art-square', art(track, true));
      loadHdArt(track);
      var split = MusicClient.splitTitle(track);
      setText(titleBox.firstElementChild, split.title);
      setText(el('author'), split.artist);
      var chip = el('chip');
      chip.hidden = false;
      chip.className = 'mo-chip' + (track.isPaid ? ' mo-chip--paid' : '');
      setText(chip, track.isBackup ? 'Плейлист' : '@' + track.requestedBy);
      chip.title = track.isPaid ? 'Донатный заказ' : '';
      setText(el('len'), MusicClient.formatTime(track.playSec || track.durationSec));
      requestAnimationFrame(updateMarquee);
    }
    var label = 'Пауза';
    if (state.status === 'waiting') label = 'Скоро следующий';
    else if (isAudible(state)) label = 'Сейчас играет';
    setText(el('label'), label);
    syncVideo(state);
  }

  // Прогресс рисуем каждый кадр из интерполированной позиции.
  function tick() {
    var state = client.getState();
    var track = state && state.current;
    if (track) {
      var elapsed = Math.max(0, client.position() - (track.startSec || 0));
      var total = track.playSec || track.durationSec || 0;
      setText(el('pos'), MusicClient.formatTime(elapsed));
      el('fill').style.width = (total > 0 ? Math.min(100, elapsed / total * 100) : 0) + '%';
    }
    requestAnimationFrame(tick);
  }

  // ---------- видео-режим: немой YouTube, синхронизированный с доком ----------
  function syncVideo(state) {
    if (mode !== 'video' || !ytReady) return;
    var track = state && state.current;
    if (!track || track.provider !== 'youtube') {
      if (ytLoadedId) { ytPlayer.stopVideo(); ytLoadedId = null; }
      return;
    }
    var target = client.position();
    if (ytLoadedId !== track.id) {
      ytLoadedId = track.id;
      videoStartedId = null;
      setVideoFallback(false);
      ytPlayer.loadVideoById({ videoId: track.externalId, startSeconds: target, endSeconds: track.endSec || undefined });
      ytPlayer.mute();
      armVideoWatchdog(track.id);
    } else if (isAudible(state) && videoStartedId !== track.id && !videoWatchdog) {
      armVideoWatchdog(track.id);
    }
    if (isAudible(state)) {
      if (ytPlayer.getPlayerState() !== 1) ytPlayer.playVideo();
    } else if (ytPlayer.getPlayerState() === 1) {
      ytPlayer.pauseVideo();
    }
  }

  function driftCheck() {
    var state = client.getState();
    if (mode !== 'video' || !ytReady || !state || !state.current || ytLoadedId !== state.current.id) return;
    if (!isAudible(state)) { syncVideo(state); return; }
    var drift = Math.abs((ytPlayer.getCurrentTime() || 0) - client.position());
    if (drift > 1.5) ytPlayer.seekTo(client.position(), true);
    syncVideo(state);
  }

  if (mode === 'video') {
    window.onYouTubeIframeAPIReady = function () {
      ytPlayer = new YT.Player('mo-yt', {
        width: '100%', height: '100%',
        playerVars: { autoplay: 1, controls: 0, disablekb: 1, fs: 0, iv_load_policy: 3, modestbranding: 1, rel: 0, playsinline: 1, mute: 1, origin: location.origin, widget_referrer: location.origin },
        events: {
          onReady: function () { ytReady = true; ytPlayer.mute(); render(client.getState()); },
          onStateChange: function (event) {
            if (event.data === 1 && ytLoadedId) {
              videoStartedId = ytLoadedId;
              clearTimeout(videoWatchdog);
              videoWatchdog = null;
              setVideoFallback(false);
            }
          },
          onError: function () { setVideoFallback(true); },
        },
      });
    };
    var script = document.createElement('script');
    script.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(script);
    setInterval(driftCheck, 2000);
  }

  var client = MusicClient.connect({
    initial: {{{initialJson}}},
    websocketPort: '{{websocketPort}}',
    onState: render,
  });
  window.addEventListener('resize', updateMarquee);
  requestAnimationFrame(tick);
})();
</script>
