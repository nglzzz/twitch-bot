<section class="admin-page admin-community-events">
  <div class="admin-page__heading">
    <div><div class="eyebrow">Сообщество</div><h1>События участников</h1></div>
  </div>
  {{#if success}}<p class="form-notice form-notice--success" role="status">{{success}}</p>{{/if}}
  {{#if error}}<p class="form-notice form-notice--error" role="alert">{{error}}</p>{{/if}}
  <p class="admin-card__hint admin-community-events__intro">Свяжите подтверждённый мем или донат с Twitch-профилем, чтобы обновить статистику участника и его достижения. Имя отправителя из источника само по себе не подтверждает Twitch-аккаунт — проверьте, кому принадлежит событие. Без галочки «Объявить в чате» событие добавится в профиль тихо.</p>

  <nav class="admin-tabs admin-tabs--events" role="tablist" aria-label="Типы событий" data-tabs>
    {{#each tabs}}
      <a class="admin-tabs__link{{#if isActive}} is-active{{/if}}" id="events-tab-{{id}}" href="?tab={{id}}" role="tab" aria-controls="events-panel-{{id}}" aria-selected="{{#if isActive}}true{{else}}false{{/if}}" data-tab="{{id}}">{{label}}{{#if count}} <span class="admin-count">{{count}}</span>{{/if}}</a>
    {{/each}}
  </nav>

  <article class="admin-card admin-community-events__card" id="events-panel-donations" role="tabpanel" aria-labelledby="events-tab-donations" data-panel="donations" {{#unless isDonationsTab}}hidden{{/unless}}>
    {{#if hasDonationEvents}}
      <div class="admin-event-list">
        {{#each donationEvents}}
          <div class="admin-event">
            <div class="admin-event__details">
              <strong>{{title}}</strong>
              <span>Отправитель в источнике: {{displayName}}</span>
              <span>{{createdAtLabel}}{{#if source}} · {{source}}{{/if}}{{#if statusLabel}} · {{statusLabel}}{{/if}}</span>
            </div>
            <form method="post" action="/admin/community-events/link" class="admin-event__form">
              <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
              <input type="hidden" name="kind" value="donation" />
              <input type="hidden" name="recordId" value="{{id}}" />
              <label class="sr-only" for="donation-twitch-login-{{id}}">Twitch-логин участника</label>
              <input class="admin-input" id="donation-twitch-login-{{id}}" name="twitchLogin" maxlength="25" pattern="[A-Za-z0-9_]{1,25}" autocomplete="off" placeholder="Twitch-логин" required />
              <label class="admin-event__announce" title="Объявить новые достижения в чате"><input type="checkbox" name="announce" /> Объявить в чате</label>
              <button class="btn btn--primary btn--compact" type="submit">Привязать</button>
            </form>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="empty-state">Нет донатов, ожидающих связи с профилем.</p>
    {{/if}}
  </article>

  <article class="admin-card admin-community-events__card" id="events-panel-memes" role="tabpanel" aria-labelledby="events-tab-memes" data-panel="memes" {{#unless isMemesTab}}hidden{{/unless}}>
    {{#if hasMemeEvents}}
      <div class="admin-event-list">
        {{#each memeEvents}}
          <div class="admin-event">
            <div class="admin-event__details">
              <strong>{{title}}</strong>
              <span>Отправитель в источнике: {{displayName}}</span>
              <span>{{createdAtLabel}}{{#if source}} · {{source}}{{/if}}{{#if statusLabel}} · {{statusLabel}}{{/if}}</span>
            </div>
            <form method="post" action="/admin/community-events/link" class="admin-event__form">
              <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
              <input type="hidden" name="kind" value="meme" />
              <input type="hidden" name="recordId" value="{{id}}" />
              <label class="sr-only" for="meme-twitch-login-{{id}}">Twitch-логин участника</label>
              <input class="admin-input" id="meme-twitch-login-{{id}}" name="twitchLogin" maxlength="25" pattern="[A-Za-z0-9_]{1,25}" autocomplete="off" placeholder="Twitch-логин" required />
              <label class="admin-event__announce" title="Объявить новые достижения в чате"><input type="checkbox" name="announce" /> Объявить в чате</label>
              <button class="btn btn--primary btn--compact" type="submit">Привязать</button>
            </form>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="empty-state">Нет мемов, ожидающих связи с профилем.</p>
    {{/if}}
  </article>

  <article class="admin-card admin-community-events__card" id="events-panel-boosty" role="tabpanel" aria-labelledby="events-tab-boosty" data-panel="boosty" {{#unless isBoostyTab}}hidden{{/unless}}>
    <p class="admin-card__hint">Совпадающие ники Boosty и Twitch связываются автоматически, но совпадение не доказывает, что это один человек: Twitch-ник берётся из истории сообщества и может устареть. Если ники различаются, свяжите аккаунты вручную после проверки.</p>
    {{#if boostySuccess}}<p class="form-notice form-notice--success" role="status">{{boostySuccess}}</p>{{/if}}
    {{#if boostyError}}<p class="form-notice form-notice--error" role="alert">{{boostyError}}</p>{{/if}}
    {{#if hasBoostySubscribers}}
      <form method="post" action="/admin/community-events/link-boosty" class="admin-event__form admin-event__form--boosty">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <label class="sr-only" for="boosty-subscriber">Активная платная подписка Boosty</label>
        <select class="admin-input" id="boosty-subscriber" name="subscriberId" required>
          <option value="">Подписчик Boosty</option>
          {{#each boostySubscribers}}<option value="{{id}}">{{name}} · ID {{id}}</option>{{/each}}
        </select>
        <label class="sr-only" for="boosty-twitch-login">Twitch-логин участника</label>
        <input class="admin-input" id="boosty-twitch-login" name="twitchLogin" maxlength="25" pattern="[A-Za-z0-9_]{1,25}" autocomplete="off" placeholder="Twitch-логин" required />
        <button class="btn btn--primary btn--compact" type="submit">Привязать</button>
      </form>
    {{else}}
      {{#unless boostyError}}<p class="empty-state">Нет активных платных подписок Boosty, ожидающих привязки.</p>{{/unless}}
    {{/if}}
  </article>
</section>
<script>
  (function () {
    var nav = document.querySelector('[data-tabs]');
    if (!nav) return;
    nav.addEventListener('click', function (event) {
      var link = event.target.closest('[data-tab]');
      if (!link) return;
      event.preventDefault();
      var tab = link.getAttribute('data-tab');
      nav.querySelectorAll('[data-tab]').forEach(function (item) {
        var active = item === link;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      document.querySelectorAll('[data-panel]').forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-panel') !== tab;
      });
      history.replaceState(null, '', '?tab=' + tab);
    });
  })();
</script>
