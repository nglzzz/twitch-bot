  <script>
    (function () {
      'use strict';
      var form = document.getElementById('music-settings-form');
      if (!form) return;
      var hint = document.getElementById('music-savebar-hint');
      var markDirty = function () { if (hint) hint.hidden = false; };
      form.addEventListener('input', markDirty);
      form.addEventListener('change', markDirty);
      form.querySelectorAll('.music-sub').forEach(function (wrap) {
        var master = form.querySelector('[name="' + wrap.getAttribute('data-dep') + '"]');
        if (!master) return;
        var sync = function () {
          var off = !master.checked;
          wrap.classList.toggle('is-off', off);
          wrap.querySelectorAll('input:not([type="checkbox"]), select, textarea').forEach(function (field) { field.disabled = off; });
        };
        master.addEventListener('change', sync);
        sync();
      });
    })();
  </script>
